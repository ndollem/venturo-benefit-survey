# Google Apps Script Web App Submit Endpoint URL
# Copy this file to '.env' and fill in your custom endpoint for local testing.
# For Vercel deployments, add VITE_SUBMIT_ENDPOINT as an Environment Variable.
#
# NOTE: this points to the DEMO spreadsheet, safe for training sessions and
# local experiments. Submissions land in a throwaway copy, not the real survey
# responses. Override it for any deployment that must record real data.
VITE_SUBMIT_ENDPOINT=https://script.google.com/macros/s/AKfycbwcvCbuFuidRkPAJ7cS3b_T3oXwGr6DChiuVW7w3CEO7N3AyHnBJcIqvRImNN6gZcXh4g/exec

# Feature toggles
# Gameplay method: 'priority' (default) | 'full' | 'skip'
#  - priority: priority slots + 2 quick-verdict buttons (want / skip)
#  - full:     priority slots + full 1-5 rating grid (richest sentiment)
#  - skip:     priority slots + single skip button only (minimal)
VITE_GAMEPLAY_MODE=priority
# Number of priority slots participants rank into (default 10)
VITE_PRIORITY_SLOTS_COUNT=10
